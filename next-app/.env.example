# ==============================================================================
# THE ABSTRACT TAKE — AUTHORITATIVE ENVIRONMENT CONFIGURATION TEMPLATE (NEXT.JS 15)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_SITE_URL="https://theabstracttake.com"
SITE_BASE_URL="https://theabstracttake.com"

# ------------------------------------------------------------------------------
# 2. GEMINI AI API (Editorial Assistant & Recommendations)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL (Sole Production Database Authority)
# ------------------------------------------------------------------------------
# Public browser-safe variables:
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Server-only secrets (NEVER prefix with NEXT_PUBLIC_):
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 4. ADMIN AUTHENTICATION (PBKDF2 SHA-512 + Stateless HMAC-SHA256 JWT)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="theabstractlens.official@gmail.com"
ADMIN_PASSWORD="your-strong-production-admin-password"
ADMIN_JWT_SECRET="your-crypto-random-jwt-signing-secret-256-bit"

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS EDITORIAL AUTOMATION
# ------------------------------------------------------------------------------
# Dedicated server-to-server secret (Must match API_SECRET in Google Apps Script)
AUTOMATION_SECRET="your-google-sheets-automation-secret-key"
GOOGLE_SHEETS_AUTOMATION_SECRET="your-google-sheets-automation-secret-key"

# ------------------------------------------------------------------------------
# 6. SCHEDULED PUBLISHING CRON
# ------------------------------------------------------------------------------
# Secret for triggering /api/cron/publish-scheduled
CRON_SECRET="your-production-cron-secret-key"

# ------------------------------------------------------------------------------
# 7. CLOUDINARY CDN MEDIA STORAGE (Posters & Banners)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 8. EXTERNAL METADATA ENRICHMENT APIS (Optional)
# ------------------------------------------------------------------------------
TMDB_API_KEY="your-tmdb-v3-api-key"

# ------------------------------------------------------------------------------
# 9. DEPRECATED LEGACY ENVIRONMENT VARIABLES (Vite / Express only - Do NOT use)
# ------------------------------------------------------------------------------
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""
